# Exhibit Packet Builder Environment Variables

# App Settings
DEBUG=True
APP_NAME="Exhibit Packet Builder"
APP_VERSION=0.1.0

# Database
# For SQLite (development):
DATABASE_URL=sqlite:///./exhibit_builder.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost/exhibit_builder

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=104857600

# Processing
TEMP_DIR=temp
OCR_ENABLED=True

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
